# Copy to .env and enter your key locally. Never paste the key into chat.
OPENAI_API_KEY=
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=512
RAG_ANSWER_MODEL=gpt-6-luna
RAG_MAX_OUTPUT_TOKENS=1800

# Local Docker Compose database only. This example password is not for AWS.
POSTGRES_USER=rag
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_DB=rag

# Local host-run API credentials. Separate from the Postgres admin above.
RAG_DB_HOST=127.0.0.1
RAG_DB_PORT=5432
RAG_DB_NAME=rag
RAG_DB_USER=rag_runtime
RAG_DB_PASSWORD=
RAG_ORGANIZATION_ID=819e5ef7-fb19-4b82-8c50-b9f44e93fa9b
RAG_INGESTOR_USER_ID=10000000-0000-4000-8000-000000000004
